#!/usr/bin/env sh
# Enforce Conventional Commit subjects: <type>(<scope>): <description>
# The release version is NOT derived from the subject anymore: it is the
# package.json bump inside the PR (see scripts/release-check.sh).
# major/minor/patch are still accepted for older branches.
#
# Exempt: merge commits, revert commits.

subject=$(head -n 1 "$1")

case "$subject" in
  "Merge "*|"Revert "*)
    exit 0
    ;;
esac

if printf '%s' "$subject" | grep -Eq '^(feat|fix|hotfix|refactor|docs|test|chore|style|enhancement|major|minor|patch)(\([^)]+\))?: .+'; then
  exit 0
fi

cat >&2 <<'EOF'
Aborting commit. Subject must follow Conventional Commits:

  <type>(<scope>): <description>

Types: feat, fix, hotfix, refactor, docs, test, chore, style, enhancement

Examples:
  fix(data-table): fire onRowClick on row click
  feat(button): add icon-only variant
  chore(ci): run build on pull requests
EOF
exit 1
